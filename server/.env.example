NODE_ENV=development
PORT=5000
# Use service names when running via docker-compose, localhost otherwise
MONGODB_URI=mongodb://mongo:27017/wpsentinel
REDIS_URL=redis://redis:6379
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@wpsentinel.com
CLIENT_URL=http://localhost:3000

# Microsoft Graph (optional) — when all three are set, mailer sends via Graph
# instead of SMTP. App registration needs Mail.Send *application* permission +
# admin consent, and SMTP_FROM must be a mailbox the app may send as.
#GRAPH_TENANT_ID=
#GRAPH_CLIENT_ID=
#GRAPH_CLIENT_SECRET=
# Optional: Graph sender override when the Graph mailbox differs from SMTP_FROM
# (e.g. SMTP_FROM is unlicensed/on-prem). Must be a licensed Exchange Online mailbox.
#GRAPH_SENDER=

# External probe nodes — format: name|url (comma-separated). Leave empty to disable.
# Example: de-cf|https://wp-sentinel-probe.YOUR_ACCOUNT.workers.dev
PROBE_URLS=
PROBE_SECRET=
